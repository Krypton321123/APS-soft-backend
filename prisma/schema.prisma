generator client {
  provider        = "prisma-client-js"
  output          = "./generated"
  previewFeatures = ["views"]
  binaryTargets   = ["native", "windows"]
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

model User {
  user_id     Int           @id @default(autoincrement())
  username    String        @unique
  password    String
  untcd       String        @default("")
  stcd        String        @default("")
  stnm        String        @default("")
  untnm       String        @default("")
  usrnm       String        @default("")
  untshnm     String?
  usrtyp      String?
  attendance  Attendance[]
  partyImages partyImages[]
}

model partyImages {
  image_id        String   @id @default(cuid())
  partyId         String
  createdAt       DateTime @default(now())
  imageUrl2       String?
  imageUrl3       String?
  profileImageUrl String
  userId          String?
  remarks         String   @default("")
  latValue        String   @default("")
  longValue       String   @default("")
  user            User?    @relation(fields: [userId], references: [username])
}

model Order {
  order_id           String           @id @default(cuid())
  partyId            String
  partyName          String
  empId              String
  totalAmount        Decimal          @db.Decimal(18, 2)
  discountAmount     Decimal          @db.Decimal(18, 2)
  createdAt          DateTime         @default(now())
  creditDays         Int?
  paymentMode        String           @default("")
  status             String           @default("pending")
  bulkRate           Decimal?         @db.Decimal(18, 2)
  consumerRate       Decimal?         @db.Decimal(18, 2)
  discountAmountBulk Decimal          @default(0) @db.Decimal(18, 2)
  accept             AcceptedOrders[]
  orderItems         OrderItem[]
  reject             RejectedOrders?
}

model AcceptedOrders {
  accept_id    String    @id @default(cuid())
  order_id     String
  createdAt    DateTime  @default(now())
  AcceptedAt   DateTime?
  adminName    String
  bulkRate     Decimal   @db.Decimal(18, 2)
  consumerRate Decimal   @db.Decimal(18, 2)
  remarks      String    @default("")
  status       String
  sicd         String    @default("")
  socd         String    @default("")
  secfreight   Float     @default(0)
  vehno        String    @default("")
  admin        admin     @relation(fields: [adminName], references: [username])
  Order        Order     @relation(fields: [order_id], references: [order_id])
}

model RejectedOrders {
  reject_id    String   @id @default(cuid())
  order_id     String   @unique
  createdAt    DateTime @default(now())
  adminName    String
  remarks      String   @default("")
  bulkRate     Decimal  @db.Decimal(18, 2)
  consumerRate Decimal  @db.Decimal(18, 2)
  admin        admin    @relation(fields: [adminName], references: [username])
  Order        Order    @relation(fields: [order_id], references: [order_id])
}

model OrderItem {
  id       String  @id @default(cuid())
  orderId  String
  itemCode String
  itemName String
  quantity Int
  rate     Decimal @db.Decimal(18, 2)
  amount   Decimal @db.Decimal(18, 2)
  packType String  @default("")
  order    Order   @relation(fields: [orderId], references: [order_id])
}

model Collection {
  collection_id String   @id @default(cuid())
  partyId       String
  partyName     String
  empId         String
  amount        Decimal  @db.Decimal(18, 2)
  paymentMethod String
  chequeNumber  String?
  chequeDate    String?
  bankName      String?
  upiId         String?  @default("")
  transactionId String?
  createdAt     DateTime @default(now())
  verified      Boolean  @default(false)
  verifiedAt    String?
  imageUrl      String?  @default("")
  otp           String?  @default("")
  verifiedBy    String?
  vchno         String?
  ledgerId      String?
  admin         admin?   @relation(fields: [verifiedBy], references: [username])
}

model PartyEditRequest {
  request_id           String   @id @default(cuid())
  partyId              String
  partyName            String
  empId                String
  updatedName          String?
  updatedAddress       String?
  updatedContactPerson String?
  updatedMobileNumber  String?
  updatedEmailId       String?
  shopImage1           String?
  shopImage2           String?
  status               String   @default("pending")
  adminComment         String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model Stock {
  stock_id   String      @id @default(cuid())
  partyId    String
  partyName  String
  empId      String
  createdAt  DateTime    @default(now())
  stockItems StockItem[]
}

model StockItem {
  id       String @id @default(cuid())
  stockId  String
  itemCode String
  itemName String
  quantity Int
  stock    Stock  @relation(fields: [stockId], references: [stock_id])
}

model admin {
  admin_id         String           @id @default(cuid())
  username         String           @unique
  password         String
  active           Boolean          @default(true)
  allowedLocations String           @default("")
  allowedScreens   String           @default("")
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @default(now()) @updatedAt
  userType         String           @default("")
  acceptedOrders   AcceptedOrders[]
  collections      Collection[]
  rejectedOrders   RejectedOrders[]
}

model Attendance {
  attendance_id   String    @id @default(cuid())
  userId          String
  date            String
  status          String    @default("not_marked")
  markedAt        DateTime?
  markedBy        String?
  absentReason    String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  attendancePhoto String?   @default("")
  user            User      @relation(fields: [userId], references: [username])

  @@unique([userId, date])
  @@index([userId])
  @@index([date])
}

model DailyRateList {
  rate_id      String   @default(cuid())
  untcd        String   @default("")
  date         DateTime
  bulkRate     Int      @default(0)
  consumerRate Int      @default(0)
  createdAt    DateTime @default(now())

  @@unique([untcd, date])
}

model employeeRouteMap {
  route_id  String               @id @default(cuid())
  empId     String
  empName   String
  createdAt DateTime             @default(now())
  date      String
  routeArr  latLongitudeValues[]

  @@unique([empId, date])
}

model latLongitudeValues {
  latlong_id String           @id @default(cuid())
  route_id   String
  lat_value  String
  long_value String
  createdAt  DateTime         @default(now())
  route      employeeRouteMap @relation(fields: [route_id], references: [route_id])
}

model DeliveryBillStatus {
  bill_id   String   @id @default(cuid())
  userId    String
  billNo    String
  otp       String
  createdAt DateTime @default(now())
  cash      String
}

model LocationNames {
  location_id  String @id @default(cuid())
  locationName String
  locationCode String
  cityName     String
  stateName    String
  cashLedgerId String @default("")
  gwncd        String @default("")
  untcd        String @default("")
}

model Flags {
  flag_id String @id @default(cuid())
  partyId String
  flag    String
}

model AppConfig {
  id                String @id @default(cuid())
  minAndroidVersion Int    @default(1)
}

model SecondaryRate {
  rate_id      String   @id @default(cuid())
  depotCd      String   @default("")
  depotNm      String   @default("")
  partyType    String   @default("")
  empId        String?
  empName      String?
  partyId      String
  partyName    String
  mobile       String   @default("")
  consumerRate Decimal  @db.Decimal(18, 2)
  bulkRate     Decimal  @db.Decimal(18, 2)
  rateDate     DateTime
  sentBy       String
  status       String   @default("pending")
  responseId   String?
  errorMsg     String?
  createdAt    DateTime @default(now())

  @@index([depotCd, rateDate])
  @@index([partyId])
  @@index([status])
}


model NewPartyOrder {
  new_party_order_id String              @id @default(cuid())
  partyName           String
  partyMobile         String
  address              String              @default("")
  pincode              String              @default("")
  gstNumber            String?             // Optional — unlike name/mobile/address/
                                           // pincode, a shop may not have GST
                                           // registration yet.
  source              String
  parentLedcd         String?             // NEW — set only when source = "secondary";
                                           // null for primary-sourced rows, which have
                                           // no parent party by definition.
  empId               String
  photoUrl             String
  totalAmount          Decimal             @db.Decimal(18, 2)
  consumerRate         Decimal?            @db.Decimal(18, 2)
  bulkRate             Decimal?            @db.Decimal(18, 2)
  paymentMode          String              @default("")
  creditDays           Int?
  status               String              @default("pending")
  createdAt            DateTime            @default(now())
  orderItems           NewPartyOrderItem[]

  @@index([empId])
  @@index([createdAt])
}


model NewPartyOrderItem {
  id              String        @id @default(cuid())
  newPartyOrderId String
  itemCode        String
  itemName        String
  quantity        Int
  rate            Decimal       @db.Decimal(18, 2)
  amount          Decimal       @db.Decimal(18, 2)
  packType        String        @default("")
  order           NewPartyOrder @relation(fields: [newPartyOrderId], references: [new_party_order_id])
}

model SecondaryOrder {
  secondary_order_id String               @id @default(cuid())
  vendId              String // mstvendor.vendcd — the child party
  parentLedcd         String // mstvendor.ledcd — the parent party
  vendName            String
  empId               String
  totalAmount         Decimal              @db.Decimal(18, 2)
  discountAmount      Decimal              @default(0) @db.Decimal(18, 2)
  discountAmountBulk  Decimal              @default(0) @db.Decimal(18, 2)
  paymentMode         String               @default("")
  creditDays          Int?
  consumerRate        Decimal?             @db.Decimal(18, 2)
  bulkRate             Decimal?             @db.Decimal(18, 2)
  createdAt           DateTime             @default(now())
  orderItems          SecondaryOrderItem[]

  @@index([vendId])
  @@index([parentLedcd])
  @@index([empId])
}

model SecondaryOrderItem {
  id               String         @id @default(cuid())
  secondaryOrderId String
  itemCode         String
  itemName         String
  quantity         Int
  rate             Decimal        @db.Decimal(18, 2)
  amount           Decimal        @db.Decimal(18, 2)
  packType         String         @default("")
  order            SecondaryOrder @relation(fields: [secondaryOrderId], references: [secondary_order_id])
}

model SecondaryStock {
  secondary_stock_id String               @id @default(cuid())
  vendId              String // mstvendor.vendcd — the child party
  parentLedcd         String // mstvendor.ledcd — the parent party
  vendName            String
  empId               String
  createdAt           DateTime             @default(now())
  stockItems          SecondaryStockItem[]

  @@index([vendId])
  @@index([parentLedcd])
  @@index([empId])
}

model SecondaryStockItem {
  id               String         @id @default(cuid())
  secondaryStockId String
  itemCode         String
  itemName         String
  quantity         Int
  stock            SecondaryStock @relation(fields: [secondaryStockId], references: [secondary_stock_id])
}


/// The underlying view does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
view mstemp {
  empcd String  @unique @db.VarChar(50)
  ledcd String  @db.VarChar(250)
  lednm String? @db.VarChar(250)
}

/// The underlying view does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
view mstparty {
  ledcd   String    @unique @db.VarChar(250)
  lednm   String?   @db.VarChar(250)
  pcatnm  String?   @db.VarChar(250)
  empcd   String?   @db.VarChar(50)
  areacd  String    @db.VarChar(50)
  areanm  String?   @db.VarChar(250)
  ledadr1 String?   @db.VarChar(500)
  outs    Decimal   @db.Decimal(38, 2)
  mobile  String?   @db.VarChar(100)
  billdt  DateTime? @db.DateTime
}

/// The underlying view does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
view mstitm {
  rowid     BigInt
  itmcd     String   @unique @db.VarChar(50)
  itmnm     String   @db.VarChar(250)
  pcksz     Decimal? @db.Decimal(18, 0)
  wgtconv   Decimal? @db.Decimal(18, 3)
  itmsubcat String?  @db.VarChar(50)
  itmcatgrp String?  @db.VarChar(50)
  lsitmnm   String?  @db.VarChar(250)
  itmrate   Int
  curcstamt Decimal? @db.Decimal(18, 2)
}

view OutstandingAmt {
  ledcd  String   @id @unique @db.VarChar(250)
  outamt Decimal? @db.Decimal(38, 2)
  billdt String?  @db.VarChar(11)
}

/// The underlying view does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
view partybills {
  billno String   @unique @db.VarChar(50)
  billdt String?  @db.VarChar(11)
  ptynm  String?  @db.VarChar(250)
  addr   String?  @db.VarChar(500)
  totqty Decimal? @db.Decimal(38, 0)
  amt    Decimal? @db.Decimal(38, 2)
  mobile String?  @db.VarChar(100)
}

/// The underlying view does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
view mstcashledger {
  ledcd   String  @unique @db.VarChar(250)
  lednm   String? @db.VarChar(250)
  buntcd  String? @db.VarChar(50)
  untshnm String? @db.VarChar(50)
}

/// The underlying view does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
view mstvendor {
  rowid    BigInt   @id @default(autoincrement())
  vendcd   String?  @db.VarChar(250)
  untcd    String?  @db.VarChar(50)
  pcatcd   String?  @db.VarChar(50)
  ledcd    String?  @db.VarChar(50)
  name     String?  @db.VarChar(250)
  adrs     String?  @db.VarChar(250)
  contper  String?  @db.VarChar(250)
  contno   String?  @db.VarChar(50)
  tin      String?  @db.VarChar(50)
  pan      String?  @db.VarChar(50)
  tsale    Decimal? @db.Decimal(18, 2)
  ssale    Decimal? @db.Decimal(18, 2)
  entusrnm String   @db.VarChar(250)
  entdt    DateTime @db.DateTime


}
